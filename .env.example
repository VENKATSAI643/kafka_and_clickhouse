# ─────────────────────────────────────────────────────────────
#  .env.example — Kafka → ClickHouse Pipeline
#
#  Copy this file to .env and fill in your values.
#  NEVER commit .env — it is in .gitignore.
# ─────────────────────────────────────────────────────────────

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC=crypto_prices

# ── Producer ──────────────────────────────────────────────────
# How often to poll CoinGecko (seconds). Min 3, recommended 60
# if you do not have a CoinGecko API key (free tier = 30 calls/min).
POLL_INTERVAL_SEC=3
COINS=bitcoin,ethereum,solana,binancecoin

# Optional: CoinGecko Pro API key (leave blank for free tier)
COINGECKO_API_KEY=

# ── Anomaly Consumer ──────────────────────────────────────────
ANOMALY_CONSUMER_GROUP=anomaly-detector
# Z-Score threshold — number of standard deviations to flag as anomaly
Z_SCORE_THRESHOLD=2.5
# Rolling window (number of messages) for Z-Score calculation
ROLLING_WINDOW=30

# ── ClickHouse ────────────────────────────────────────────────
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=default
CLICKHOUSE_USER=default
# Set a strong password in any non-local environment
CLICKHOUSE_PASSWORD=
