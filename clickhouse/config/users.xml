<?xml version="1.0"?>
<!--
  ClickHouse users configuration override.
  Mounted at /etc/clickhouse-server/config.d/users.xml

  For local dev: default user with no password, full access.
  Change the password and restrict networks in production.
-->
<clickhouse>
  <users>
    <default>
      <!-- No password for local development -->
      <password></password>

      <!-- Allow connections from any IP (Docker network + localhost) -->
      <networks>
        <ip>::/0</ip>
      </networks>

      <!-- Full access profile -->
      <profile>default</profile>
      <quota>default</quota>

      <!-- Allow DDL (CREATE, DROP, ALTER) -->
      <access_management>1</access_management>
    </default>
  </users>

  <profiles>
    <default>
      <max_memory_usage>10000000000</max_memory_usage>
      <use_uncompressed_cache>0</use_uncompressed_cache>
      <load_balancing>random</load_balancing>
    </default>
  </profiles>

  <quotas>
    <default>
      <interval>
        <duration>3600</duration>
        <queries>0</queries>
        <errors>0</errors>
        <result_rows>0</result_rows>
        <read_rows>0</read_rows>
        <execution_time>0</execution_time>
      </interval>
    </default>
  </quotas>
</clickhouse>
